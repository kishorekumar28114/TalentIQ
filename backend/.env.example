# =====================================================================
# Job-Matcher Backend Environment Variables
# =====================================================================

# Server Configuration
PROJECT_NAME="Job-Matcher Agentic RAG API"
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Groq API Configuration
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended production models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama3-70b-8192
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Configuration (Async Motor & LangGraph Checkpointer)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=job_matcher_db

# Cloudinary Configuration (Resume PDF/Image Upload)
# Get credentials at https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ChromaDB Vector Storage Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=job_market

# Matchmaking & Scraping Configuration
# Cosine distance threshold (0.0 = identical, 1.0+ = dissimilar). If distance > threshold, fallback to base excel data
SIMILARITY_DISTANCE_THRESHOLD=0.85

# Target Companies for Live Scraping (comma-separated)
TARGET_COMPANIES=Google,Microsoft,Amazon,Meta,Apple,Netflix,Stripe,Uber,Databricks,OpenAI
